# Copy to .env.local (git ignores it) and fill in what you need.

# Optional. Lets RackPilot offer a Claude reading when the rules aren't sure
# about a message. Used only on the server; stock is still decided by code.
ANTHROPIC_API_KEY=

# Optional. Model for the fallback reader; defaults to claude-opus-5-5.
# CLAUDE_MODEL=claude-opus-5-5

# Optional. Where the SQLite database lives; defaults to ./local.db.
# DATABASE_PATH=./local.db
