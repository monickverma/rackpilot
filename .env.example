# Copy to .env.local (git ignores it) and fill in what you need. Everything is optional.

# Signs the demo session cookie. Set a long random value in any shared deployment.
# SESSION_SECRET=

# Where the database lives: a folder for PGlite (default ./.pglite), or "memory"
# for a throwaway in-memory database (the default on Vercel and in tests).
# RACKPILOT_DB=./.pglite

# Lets RackPilot use Claude to read order messages, photos and PDFs, route
# assistant questions and word explanations. Used only on the server; stock,
# money and investigation findings are always decided by code.
ANTHROPIC_API_KEY=

# Model for those calls; defaults to claude-opus-5-5.
# CLAUDE_MODEL=claude-opus-5-5
